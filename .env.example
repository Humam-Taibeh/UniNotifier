# =====================================================================================
#  UniNotifier settings
# =====================================================================================
#  1. Copy this file to ".env" in the same folder:      copy .env.example .env
#  2. Fill in the REQUIRED values. Leave an optional value empty to switch it off.
#  3. Check your work:   .venv\Scripts\python -m uninotifier.doctor
#
#  Rules of the format: one NAME=value per line, no spaces around "=", no quotes needed
#  (even for paths with spaces). Lines starting with # are comments.
#
#  .env is git-ignored: it never leaves your PC. Never paste its contents anywhere,
#  and never commit it. Every value here is masked in the program's logs and alerts.
# =====================================================================================


# -------------------------------------------------------------------------------------
#  1. Moodle / e-learning (elearning.zuj.edu.jo)                          REQUIRED
# -------------------------------------------------------------------------------------
#  The Microsoft account you sign in to Moodle with: your university e-mail and its
#  password. If Microsoft asks for a second step (Authenticator / SMS), the bot sends
#  the request to you on Telegram.
ZUJ_USERNAME=your_student_id@std-zuj.edu.jo
ZUJ_PASSWORD=your_password


# -------------------------------------------------------------------------------------
#  2. Telegram                                                             REQUIRED
# -------------------------------------------------------------------------------------
#  TELEGRAM_BOT_TOKEN - your own, private bot:
#    1. Open Telegram, search for @BotFather and press Start.
#    2. Send /newbot, choose a display name, then a username ending in "bot".
#    3. BotFather replies with a token like 123456789:AAH4x...  - paste it below.
#    Anyone with the token controls the bot: keep it secret (/revoke in BotFather if leaked).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

#  TELEGRAM_CHAT_ID - where the bot writes to you:
#    1. Search for @userinfobot on Telegram and press Start: it replies with your "Id".
#    2. Open YOUR new bot (t.me/<its username>) and press Start - a bot can't
#       message you before you have written to it once.
TELEGRAM_CHAT_ID=your_telegram_chat_id

#  ADMIN_USER_ID - the only Telegram user the bot answers: the same Id as above.
#  Everyone else is ignored without a reply, and you are told when a stranger tries.
#  (Optional: when empty, TELEGRAM_CHAT_ID is used.)
ADMIN_USER_ID=


# -------------------------------------------------------------------------------------
#  3. Registration portal (portal.zuj.edu.jo)                              optional
# -------------------------------------------------------------------------------------
#  Used only when you ask for it: Transcript, Balance, and Finals Watch during exams.
#  Never polled otherwise. This login may differ from the Moodle one above.
PORTAL_USERNAME=
PORTAL_PASSWORD=

#  Your university number - finds your own marks inside result files the instructors
#  upload (e.g. a midterm-results PDF). When empty, PORTAL_USERNAME is used.
STUDENT_ID=


# -------------------------------------------------------------------------------------
#  4. Where course files are saved                                         optional
# -------------------------------------------------------------------------------------
#  Every downloaded file is filed under this folder, one subfolder per course
#  (01_Lectures, 02_Assignments, 03_Exams). Use a full path; %USERPROFILE% works.
#  Empty = %USERPROFILE%\Documents\University
#  Example: ARCHIVE_ROOT=%USERPROFILE%\Documents\University\Year_3\Semester_1
ARCHIVE_ROOT=


# -------------------------------------------------------------------------------------
#  5. Health monitoring with healthchecks.io                               optional
# -------------------------------------------------------------------------------------
#  Free alerts when your PC is off or the program stopped. Create a free account on
#  healthchecks.io, add a check, and paste its ping URL (https://hc-ping.com/...).
#  HEALTHCHECK_URL      - the 15-minute check.  Suggested: period 15 min, grace 1 h 45 min.
#  BOT_HEALTHCHECK_URL  - a SECOND check, for the always-on bot. Period 5 min, grace 15 min.
HEALTHCHECK_URL=
BOT_HEALTHCHECK_URL=


# -------------------------------------------------------------------------------------
#  6. Cambridge One assignments                                  optional, temporary
# -------------------------------------------------------------------------------------
#  For the English course on cambridgeone.org: new assignments are announced, with a
#  reminder 24 h before the due time while activities are still open. Needs BOTH values:
#    CAMBRIDGE_ASSIGNMENTS_URL - open your class's "My assignments" page in the browser
#                                and copy the address from the address bar.
#    CAMBRIDGE_UNTIL           - the last day to watch (YYYY-MM-DD); it stops by itself.
#  Then sign in once:   .venv\Scripts\python -m uninotifier.cambridge --login
CAMBRIDGE_ASSIGNMENTS_URL=
CAMBRIDGE_UNTIL=


# -------------------------------------------------------------------------------------
#  7. Advanced                                                             optional
# -------------------------------------------------------------------------------------
#  Seconds the bot waits for news in each Telegram request (5-50, default 20).
#  Lower it only if your network drops long-idle connections.
BOT_POLL_TIMEOUT=
