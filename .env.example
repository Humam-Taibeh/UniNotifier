# =====================================================================================
#  UniNotifier settings
# =====================================================================================
#  1. Copy this file to ".env" in the same folder:      copy .env.example .env
#  2. Fill in the REQUIRED values. Leave an optional value empty to switch it off.
#  3. Check your work:   .venv\Scripts\python -m uninotifier.doctor
#
#  Rules of the format: one NAME=value per line, no spaces around "=", no quotes needed
#  (even for paths with spaces). Lines starting with # are comments.
#
#  .env is git-ignored: it never leaves your PC. Never paste its contents anywhere,
#  and never commit it. Every value here is masked in the program's logs and alerts.
# =====================================================================================


# -------------------------------------------------------------------------------------
#  1. Moodle / e-learning (elearning.zuj.edu.jo)                          REQUIRED
# -------------------------------------------------------------------------------------
#  The Microsoft account you sign in to Moodle with: your university e-mail and its
#  password. If Microsoft asks for a second step (Authenticator / SMS), the bot sends
#  the request to you (on Slack or Telegram).
ZUJ_USERNAME=your_student_id@std-zuj.edu.jo
ZUJ_PASSWORD=your_password

#  AUTO_MARK_DONE=true - when the bot has saved a lecture file (or opened a link) for you, it
#  ticks "Mark as done" on Moodle by itself. Your instructor's completion report then shows it
#  as done although you may not have opened it yet - so it is off unless you choose it.
#  Assignments, quizzes and forums are never ticked. Empty or false = off (the message still
#  has a Mark as done button you can press yourself).
AUTO_MARK_DONE=


# -------------------------------------------------------------------------------------
#  2. Telegram                                     required only if you use Telegram
# -------------------------------------------------------------------------------------
#  TELEGRAM_BOT_TOKEN - your own, private bot:
#    1. Open Telegram, search for @BotFather and press Start.
#    2. Send /newbot, choose a display name, then a username ending in "bot".
#    3. BotFather replies with a token like 123456789:AAH4x...  - paste it below.
#    Anyone with the token controls the bot: keep it secret (/revoke in BotFather if leaked).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

#  TELEGRAM_CHAT_ID - where the bot writes to you:
#    1. Search for @userinfobot on Telegram and press Start: it replies with your "Id".
#    2. Open YOUR new bot (t.me/<its username>) and press Start - a bot can't
#       message you before you have written to it once.
TELEGRAM_CHAT_ID=your_telegram_chat_id

#  ADMIN_USER_ID - the only Telegram user the bot answers: the same Id as above.
#  Everyone else is ignored without a reply, and you are told when a stranger tries.
#  (Optional: when empty, TELEGRAM_CHAT_ID is used.)
ADMIN_USER_ID=

# -------------------------------------------------------------------------------------
#  2b. Slack (the way the installer sets up by default)         required if you use Slack
# -------------------------------------------------------------------------------------
#  For a network that blocks Telegram, or if you prefer Slack: every message the program
#  sends then goes to Slack. Do not fill these by hand - run the setup, it makes the app
#  with you, finds your conversation and writes them all:
#      .venv\Scripts\python -m uninotifier.setup --slack
#  NOTIFY_VIA=slack sends to Slack; telegram (or empty) sends to Telegram as before.
#  With SLACK_APP_TOKEN (xapp-..., the app's live connection) and SLACK_USER (you) too, the
#  whole bot lives in Slack: its menus on the app's Home page, real buttons, typed commands.
NOTIFY_VIA=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_APP_TOKEN=
SLACK_USER=


# -------------------------------------------------------------------------------------
#  3. Registration portal (portal.zuj.edu.jo)                              optional
# -------------------------------------------------------------------------------------
#  With these two filled in, the bot reads your weekly timetable from the portal by itself
#  (its home page: once a semester, and again on /check), builds its lecture alerts from it and
#  draws it for the Weekly Timetable button - no schedule.json to write. They also give you
#  Transcript and Balance when you ask, and Finals Watch during exams. Never polled otherwise.
#  This login may differ from the Moodle one above.
PORTAL_USERNAME=
PORTAL_PASSWORD=

#  AUTO_CHECK_IN=true - the bot checks you in to every ONLINE lecture by itself, as soon as
#  the instructor opens attendance, and sends you the proof (a screenshot) - or tells you to do
#  it by hand when it cannot. Never an in-person or activity day. It knows which days are online
#  from the portal's timetable, so it needs the portal login above. Empty or false = off.
#  Your responsibility: it marks you Present whether or not you attend - switch it off for a
#  lecture you will miss. Your attendance is always what your instructor decides (DISCLAIMER.md).
AUTO_CHECK_IN=

#  Your university number - finds your own marks inside result files the instructors
#  upload (e.g. a midterm-results PDF). When empty, PORTAL_USERNAME is used.
STUDENT_ID=


# -------------------------------------------------------------------------------------
#  4. Where course files are saved                                         optional
# -------------------------------------------------------------------------------------
#  Every downloaded file is filed under this folder, one subfolder per course
#  (01_Lectures, 02_Assignments, 03_Exams). Use a full path; %USERPROFILE% works.
#  Empty = University in your Documents folder (OneDrive's, if OneDrive backs it up)
#  Example: ARCHIVE_ROOT=%USERPROFILE%\Documents\University\Year_3\Semester_1
ARCHIVE_ROOT=


# -------------------------------------------------------------------------------------
#  5. Health monitoring with healthchecks.io                               optional
# -------------------------------------------------------------------------------------
#  Free alerts when your PC is off or the program stopped. Create a free account on
#  healthchecks.io, add a check, and paste its ping URL (https://hc-ping.com/...).
#  HEALTHCHECK_URL      - the 15-minute check.  Suggested: period 15 min, grace 45 min.
#  BOT_HEALTHCHECK_URL  - a SECOND check, for the always-on bot. Period 5 min, grace 15 min.
HEALTHCHECK_URL=
BOT_HEALTHCHECK_URL=


# -------------------------------------------------------------------------------------
#  6. Cambridge One assignments                                  optional, temporary
# -------------------------------------------------------------------------------------
#  ONLY if one of your courses (at ZUJ: English Communication Skills) hands out its
#  assignments on cambridgeone.org. Leave all four values below EMPTY otherwise: the
#  feature then stays completely off - it never opens Cambridge One and never asks for
#  an e-mail or a password. (`python -m uninotifier.doctor` shows whether it is on.)
#
#  When on, new assignments are announced, with a
#  reminder 24 h before the due time while activities are still open. Needs BOTH values:
#    CAMBRIDGE_ASSIGNMENTS_URL - open your class's "My assignments" page in the browser
#                                and copy the address from the address bar.
#    CAMBRIDGE_UNTIL           - the last day to watch (YYYY-MM-DD); it stops by itself.
#                                It also stops earlier, by itself, once your class no longer
#                                opens on Cambridge One (the course is over) - you are told once.
#  Then sign in once:   .venv\Scripts\python -m uninotifier.cambridge --login
#
#  Cambridge ends a session after about 3 days. Fill these two and the bot signs in again by
#  itself; leave them empty and it asks you (on Telegram) to run --login each time.
#  Put the password in 'single quotes' if it holds #, spaces or other symbols.
#    CAMBRIDGE_EMAIL           - the user name or e-mail you sign in with
#    CAMBRIDGE_PASSWORD        - its password
CAMBRIDGE_ASSIGNMENTS_URL=
CAMBRIDGE_UNTIL=
CAMBRIDGE_EMAIL=
CAMBRIDGE_PASSWORD=


# -------------------------------------------------------------------------------------
#  7. Advanced                                                             optional
# -------------------------------------------------------------------------------------
#  Seconds the bot waits for news in each Telegram request (5-50, default 20).
#  Lower it only if your network drops long-idle connections.
BOT_POLL_TIMEOUT=
