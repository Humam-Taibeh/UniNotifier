# Editor settings shared by every editor that supports EditorConfig (VS Code with its extension,
# PyCharm, Notepad++ ...): the files keep one style whoever edits them. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

# Windows scripts keep Windows line endings (see .gitattributes)
[*.{bat,cmd,ps1}]
end_of_line = crlf
